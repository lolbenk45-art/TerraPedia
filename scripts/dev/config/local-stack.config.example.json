{
  "database": {
    "name": "terria_v1_local",
    "host": "127.0.0.1",
    "port": 13306,
    "username": "root",
    "password": "root"
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6380,
    "database": 0,
    "password": "root",
    "dataDir": "~/.local/share/terrapedia/redis/redis-6380"
  },
  "automationTestIsolation": {
    "enabled": false,
    "manifestDir": "reports/crawler-automation/manifests",
    "runKeyRegistry": "reports/crawler-automation/run-key-mappings.json",
    "t0DatabasePrefix": "terria_v1_automation_test_",
    "t1DatabasePrefix": "terria_v1_automation_acceptance_",
    "provisionerCredentialRole": "automation-provisioner",
    "expectedServerIdentity": {
      "host": "127.0.0.1",
      "port": 13306,
      "serverUuid": "set-from-isolated-test-server",
      "redisHost": "127.0.0.1",
      "redisPort": 6380,
      "environmentId": "local-automation-test"
    },
    "formalDatabasesReadOnly": ["terria_v1_local", "terria_v1_maint", "terria_v1_relation"]
  },
  "backend": {
    "port": 18088
  },
  "front": {
    "projectDir": "front-nuxt",
    "port": 5174
  },
  "admin": {
    "port": 3001
  },
  "auth": {
    "admin": {
      "username": "admin",
      "password": "admin",
      "displayName": "Admin",
      "tokenSecret": "set-a-local-admin-token-secret"
    },
    "user": {
      "tokenSecret": "set-a-local-user-token-secret"
    }
  },
  "minio": {
    "enabled": false,
    "credentialsFile": "scripts/dev/config/credentials.json",
    "endpoint": "http://127.0.0.1:19000",
    "publicEndpoint": "http://localhost:19000",
    "bucket": "terrapedia-images",
    "objectPrefix": "items",
    "dataDir": "~/.local/share/terrapedia/minio/data",
    "consolePort": 19001
  },
  "flaresolverr": {
    "enabled": false,
    "url": "http://127.0.0.1:8191/v1",
    "containerName": "terrapedia-flaresolverr",
    "image": "ghcr.io/flaresolverr/flaresolverr"
  },
  "mail": {
    "enabled": true,
    "host": "smtp.qq.com",
    "port": 465,
    "username": "your-qq-email@example.com",
    "password": "set-your-smtp-authorization-code",
    "from": "your-qq-email@example.com",
    "fromName": "TerraPedia",
    "subjectPrefix": "[TerraPedia]",
    "sslEnable": true,
    "starttlsEnable": false
  },
  "dataRefresh": {
    "enabled": false,
    "mode": "apply",
    "intervalMinutes": 180,
    "startupDelaySeconds": 30,
    "heartbeatSeconds": 15,
    "staleLockMinutes": 360,
    "resume": true,
    "timeoutMs": 1200000,
    "steps": "",
    "reportDir": "reports/backend-refresh/history",
    "lockFile": "reports/backend-refresh/backend-refresh.lock.json",
    "stateFile": "reports/backend-refresh/backend-refresh-scheduler.latest.json",
    "heartbeatFile": "reports/backend-refresh/backend-refresh-daemon.heartbeat.json"
  }
}
