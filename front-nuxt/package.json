{
  "name": "terrapedia-front-nuxt",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 5176",
    "build": "nuxt build",
    "check": "pnpm run check:runtime-config && pnpm run check:user-module && pnpm run check:public-pages && pnpm run check:display-date-time && pnpm run check:article-comments-runtime && pnpm run check:user-article-editor && pnpm run check:user-article-editor-runtime && pnpm run check:article-content-references && pnpm run check:nav-layout && pnpm run check:front-layout-layering && pnpm run check:detail-layout && pnpm run check:preview-images && pnpm run check:visual-system && pnpm run check:light-button-tokens && pnpm run check:button-style-options && pnpm run check:css-ratchet && pnpm run check:breakpoints && pnpm run check:biome-pagination && pnpm run check:armor-stat-visuals && pnpm run check:armor-builds && pnpm run check:armor-aggregate && pnpm run check:crafting-structure && pnpm run check:crafting-alternatives && pnpm run check:category-navigation && nuxt typecheck",
    "test": "pnpm run check && pnpm run build && pnpm run test:unit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e:auth:smoke": "playwright test e2e/user-auth.smoke.spec.ts",
    "test:e2e:auth:regression": "playwright test e2e/user-auth.regression.spec.ts",
    "check:runtime-config": "node scripts/check-runtime-config.mjs",
    "check:user-module": "node scripts/check-user-module-contract.mjs",
    "check:display-date-time": "node scripts/check-display-date-time.mjs",
    "check:article-comments-runtime": "node scripts/check-article-comments-runtime.mjs",
    "check:user-article-editor": "node scripts/check-user-article-editor-dom.mjs",
    "check:user-article-editor-runtime": "node scripts/check-user-article-editor-runtime.mjs",
    "check:article-content-references": "node scripts/check-article-content-references.mjs",
    "check:armor-builds": "node scripts/check-armor-build-projection-groups.mjs",
    "check:armor-aggregate": "node scripts/check-armor-aggregate-contract.mjs",
    "check:crafting-alternatives": "node scripts/check-crafting-alternative-summaries.mjs",
    "check:crafting-structure": "node scripts/check-crafting-structure-contract.mjs",
    "check:crafting-wiki-structure": "node scripts/check-crafting-wiki-structure-runtime.mjs",
    "check:category-navigation": "node scripts/check-category-navigation-contract.mjs",
    "check:loading-skeleton": "node scripts/check-loading-skeleton-contract.mjs",
    "check:public-pages": "node scripts/check-public-pages.mjs",
    "check:home-visual-lightweight": "node scripts/check-home-visual-lightweight-runtime.mjs",
    "check:nav-layout": "node scripts/check-nav-layout-contract.mjs",
    "check:front-layout-layering": "node scripts/check-front-layout-layering-contract.mjs",
    "check:detail-layout": "node scripts/check-detail-layout-contract.mjs",
    "check:preview-images": "node scripts/check-preview-image-fallback-contract.mjs",
    "check:armor-stat-visuals": "node scripts/check-armor-stat-visuals.mjs",
    "check:light-theme": "node scripts/check-light-theme-typography.mjs",
    "check:typography-spacing": "node scripts/check-typography-spacing.mjs",
    "check:visual-system": "node scripts/check-visual-system-contract.mjs",
    "check:light-button-tokens": "node scripts/check-light-button-tokens.mjs",
    "check:button-style-options": "node scripts/check-button-style-options.mjs",
    "check:css-ratchet": "node scripts/check-css-ratchet.mjs",
    "check:breakpoints": "node scripts/check-breakpoint-whitelist-contract.mjs",
    "check:biome-pagination": "node scripts/check-biome-pagination-contract.mjs",
    "check:visual-blocked-source": "node scripts/check-visual-blocked-source-scan.mjs",
    "check:visual": "node scripts/check-visual-regression.mjs",
    "audit:preview-images": "node scripts/audit-preview-image-fallback-runtime.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@pinia/nuxt": "^0.11.3",
    "dompurify": "^3.4.12",
    "nuxt": "^4.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3",
    "vue-tsc": "^3.2.6"
  }
